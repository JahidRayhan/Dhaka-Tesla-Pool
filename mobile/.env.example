# Base URL of the Dhaka Tesla Pool API. No trailing slash.
#   Deployed:               https://dhaka-tesla-pool-vkao.onrender.com
#   iOS simulator:          http://localhost:4000
#   Android emulator:       http://10.0.2.2:4000
#   Physical phone (LAN):   http://<your-computer-LAN-ip>:4000
EXPO_PUBLIC_API_URL=https://dhaka-tesla-pool-vkao.onrender.com

# The public web address of the site (no trailing slash). "Share my trip" links are built from it:
#   <this>/trip?t=<token>
EXPO_PUBLIC_WEB_URL=https://dhakateslapool.netlify.app

# The public web address (used to build "share my trip" links that friends open in a browser).
# No trailing slash.
EXPO_PUBLIC_WEB_URL=https://your-site.netlify.app
