{
  // Type-checks the existing JavaScript WITHOUT converting it: the compiler reads
  // the code (and the @types packages) and reports real mistakes such as a missing
  // import, a misspelled property or a wrong argument count. `strict` is off on
  // purpose so adoption is gradual; tighten it file by file or flag by flag.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*.js", "scripts/**/*.js"]
}
