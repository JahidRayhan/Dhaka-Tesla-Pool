NODE_ENV=development
PORT=4000

# Matches the `db` service in docker-compose.yml
DATABASE_URL=postgresql://tesla:tesla@db:5432/dhaka_tesla_pool

# Required. In production (NODE_ENV=production) the server refuses to start
# unless this is >= 32 chars and not a placeholder: `openssl rand -hex 32`
JWT_SECRET=change_me_dev_only
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API.
# Unset = any origin (fine for local dev / docker compose). Set it in production:
#   CORS_ORIGINS=https://your-site.netlify.app,http://localhost:3000
CORS_ORIGINS=

# Failed-login throttle: max failed attempts per account+IP within the window.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
